{
  "name": "mara",
  "description": "Equities research terminal",
  "repository": "https://github.com/SriJayavel/Stock-Dashboard.git",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build --mode demo",
    "build:demo": "npm run build",
    "build:live": "vite build",
    "preview": "vite preview",
    "lint": "node scripts/check-syntax.mjs",
    "typecheck": "npm exec --yes --package=typescript@5.9.3 -- tsc -p tsconfig.json",
    "test:unit": "node --test tests/unit/*.test.js",
    "test:smoke": "playwright test --config=playwright.config.js",
    "test:demo": "playwright test --config=playwright.demo.config.js"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.63.0",
    "vite": "^5.2.0"
  },
  "allowScripts": {
    "esbuild@0.21.5": true
  }
}
